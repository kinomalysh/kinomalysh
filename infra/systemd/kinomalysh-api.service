[Unit]
Description=Kinomalysh API (Fastify)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/kinomalysh/app/apps/api
EnvironmentFile=/etc/kinomalysh/db.env
EnvironmentFile=/etc/kinomalysh/s3.env
EnvironmentFile=/etc/kinomalysh/api.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kinomalysh/app/apps/api/uploads

[Install]
WantedBy=multi-user.target
